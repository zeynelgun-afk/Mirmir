; Mırmır desktop feasibility lab. Main product engine: Unreal Engine 5.
config_version=5

[application]
config/name="Mırmır · Masaüstü Laboratuvarı"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="mirmir"
config/icon="res://icon.svg"

[display]
window/size/viewport_width=880
window/size/viewport_height=700
window/size/window_width_override=880
window/size/window_height_override=700
window/size/borderless=true
window/size/transparent=true
window/size/always_on_top=true
window/size/no_focus=true
window/per_pixel_transparency/allowed=true
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
viewport/transparent_background=true
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
anti_aliasing/quality/msaa_3d=2

[audio]
driver/enable_input=false

[physics]
common/physics_ticks_per_second=30
